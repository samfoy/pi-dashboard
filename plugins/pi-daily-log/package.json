{
  "name": "pi-daily-log-plugin",
  "version": "0.1.0",
  "private": true,
  "pi-dashboard-plugin": {
    "id": "pi-daily-log",
    "name": "Pi Daily & Oncall Log",
    "description": "Rich rendering for daily_log and oncall_log tools",
    "client": "src/client.tsx",
